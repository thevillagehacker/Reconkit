# Optional environment overrides (higher priority than config/agent_config.json).
#
# List providers:
#   python recon_agents.py providers
# Switch + test:
#   python recon_agents.py config set --provider xai --model grok-2-latest
#   python recon_agents.py check-llm

# Force a specific config file
# RECON_AGENT_CONFIG=/path/to/config/agent_config.json

# Generic LLM overrides
# RECON_LLM_PROVIDER=ollama|openai|xai|anthropic|google|openrouter|groq|deepseek|together|mistral|fireworks|custom
# RECON_LLM_MODEL=...
# RECON_LLM_BASE_URL=...
# RECON_LLM_API_KEY=...
# RECON_LLM_TIMEOUT=300
# RECON_LLM_TEMPERATURE=0.2
# RECON_LLM_OPENAI_COMPAT=false

# ---------- Local Ollama ----------
# RECON_LLM_PROVIDER=ollama
# RECON_LLM_MODEL=qwen3:8b
# RECON_LLM_BASE_URL=http://192.168.1.4:11434
# OLLAMA_MODEL=qwen3:8b

# ---------- xAI Grok ----------
# RECON_LLM_PROVIDER=xai
# RECON_LLM_MODEL=grok-2-latest
# XAI_API_KEY=xai-...
# GROK_API_KEY=...   # alias

# ---------- Anthropic Claude ----------
# RECON_LLM_PROVIDER=anthropic
# RECON_LLM_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_API_KEY=...  # alias

# ---------- OpenAI ----------
# RECON_LLM_PROVIDER=openai
# RECON_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Google Gemini / Gemma ----------
# RECON_LLM_PROVIDER=google
# RECON_LLM_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=...
# GEMINI_API_KEY=...  # alias
# RECON_LLM_PROVIDER=gemma
# RECON_LLM_MODEL=gemma-3-27b-it

# ---------- OpenRouter (Claude/Gemma/etc behind one key) ----------
# RECON_LLM_PROVIDER=openrouter
# RECON_LLM_MODEL=google/gemma-2-27b-it
# OPENROUTER_API_KEY=...

# ---------- Groq / DeepSeek / Together / Mistral / Fireworks ----------
# RECON_LLM_PROVIDER=groq
# GROQ_API_KEY=...
# RECON_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=...
# RECON_LLM_PROVIDER=together
# TOGETHER_API_KEY=...
# RECON_LLM_PROVIDER=mistral
# MISTRAL_API_KEY=...
# RECON_LLM_PROVIDER=fireworks
# FIREWORKS_API_KEY=...

# Custom OpenAI-compatible gateway
# RECON_LLM_PROVIDER=custom
# RECON_LLM_BASE_URL=https://my-gateway.example.com/v1
# RECON_LLM_MODEL=my-model
# RECON_LLM_API_KEY=...
