{
  "_comment": "Ready-made llm blocks for cloud providers. Copy ONE block into agent_config.json under \"llm\", or use: python recon_agents.py config set --provider <name>. Never commit real keys — use env vars listed in key_env.",
  "presets": {
    "xai_grok": {
      "key_env": "XAI_API_KEY",
      "setup_powershell": [
        "$env:XAI_API_KEY = 'xai-...'",
        "python recon_agents.py config set --provider xai --model grok-2-latest",
        "python recon_agents.py check-llm"
      ],
      "llm": {
        "provider": "xai",
        "model": "grok-2-latest",
        "base_url": "https://api.x.ai/v1",
        "api_key": "",
        "temperature": 0.2,
        "timeout": 120,
        "use_openai_compat": true
      }
    },
